{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "TalentLens: Backend",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"uvicorn",
				"backend.main:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000",
				"--reload",
				"--reload-dir",
				"backend"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "TalentLens: Frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}